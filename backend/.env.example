APP_ENV=development
APP_NAME=Personal Web Backend
APP_DEBUG=true
API_PREFIX=/api
DATABASE_URL=postgresql+psycopg://personal_web_dev:dev_password@127.0.0.1:5432/personal_web_dev
ALLOW_DEV_TOOLS=true
PERSONAL_WEB_DATA_PROFILE=local
CORS_ALLOW_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
SESSION_COOKIE_NAME=personal_web_session
SESSION_EXPIRE_DAYS=7
SESSION_SECRET=development-only-change-me
COOKIE_SECURE=false
CSRF_HEADER_NAME=X-CSRF-Token
HOMEPAGE_MEDIA_ROOT=data/uploads/homepage
HOMEPAGE_MEDIA_STORAGE_BACKEND=filesystem
HOMEPAGE_IMAGE_MAX_MB=10
HOMEPAGE_VIDEO_MAX_MB=100
MESSAGE_RATE_LIMIT_ENABLED=true
MESSAGE_RATE_LIMIT_MAX=5
MESSAGE_RATE_LIMIT_WINDOW_SECONDS=600

# Shared remote development is explicit and development-only.
# Do not put real shared secrets in this file. The shared launcher reads the
# protected external secret file into process memory only.
# PERSONAL_WEB_DATA_PROFILE=shared_remote
# HOMEPAGE_MEDIA_STORAGE_BACKEND=sftp
# SHARED_DEV_MEDIA_SSH_ALIAS=shared-media
# SHARED_DEV_MEDIA_SSH_CONFIG_PATH=C:\path\to\synthetic\ssh_config
# SHARED_DEV_MEDIA_REMOTE_ROOT=/srv/example/shared-dev/homepage
# SHARED_DEV_MEDIA_CACHE_MAX_MB=512
# SHARED_DEV_MEDIA_CACHE_RETENTION_DAYS=7
