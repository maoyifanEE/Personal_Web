# Personal_Web production environment template.
# Copy this to /etc/personal-web/personal-web.env on the server.
# Never commit the real environment file.
# Restrict the real file permissions, for example owner-readable only.

APP_ENV=production
ALLOW_DEV_TOOLS=false
APP_DEBUG=false
COOKIE_SECURE=true
SESSION_SECRET=<REPLACE_WITH_LONG_RANDOM_SECRET>
DATABASE_URL=<REPLACE_WITH_PRODUCTION_POSTGRESQL_URL>
CORS_ALLOW_ORIGINS=https://maoyifan0801.com,https://www.maoyifan0801.com
HOMEPAGE_MEDIA_ROOT=data/uploads/homepage
MESSAGE_RATE_LIMIT_ENABLED=true
MESSAGE_RATE_LIMIT_MAX=5
MESSAGE_RATE_LIMIT_WINDOW_SECONDS=600

# Production notes:
# - Do not use development seed credentials.
# - Do not use the default development session secret.
# - Do not use wildcard CORS.
# - Store this file outside GitHub under /etc/personal-web/.
# - Keep PostgreSQL credentials, session secrets, and private values only here
#   or in an equivalent server-side secret store.
