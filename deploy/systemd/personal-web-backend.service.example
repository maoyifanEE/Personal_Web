[Unit]
Description=Personal_Web FastAPI backend
After=network.target postgresql.service

[Service]
Type=simple
User=personal-web
Group=personal-web
WorkingDirectory=/var/www/personal_web/backend
EnvironmentFile=/etc/personal-web/personal-web.env
ExecStart=/var/www/personal_web/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
SyslogIdentifier=personal-web-backend

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/personal_web/backend /var/www/personal_web/data /var/backups/personal-web

[Install]
WantedBy=multi-user.target
