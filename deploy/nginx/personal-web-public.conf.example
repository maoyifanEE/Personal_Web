# Personal_Web phase-1 public surface example.
# This is a template only. Review paths and certificate locations before use.

server {
    listen 80;
    listen [::]:80;
    server_name maoyifan0801.com www.maoyifan0801.com;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name maoyifan0801.com www.maoyifan0801.com;

    root /var/www/personal_web;
    index index.html;

    ssl_certificate /etc/letsencrypt/live/maoyifan0801.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/maoyifan0801.com/privkey.pem;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location ~ /\.(?!well-known/) {
        return 404;
    }

    location ~* \.(env|ini|log|sql|sqlite|sqlite3|db|bak|zip|tar|gz|pem|key)$ {
        return 404;
    }

    location = / {
        try_files /index.html =404;
    }

    location = /index.html {
        try_files /index.html =404;
    }

    location = /journey.html {
        try_files /journey.html =404;
    }

    location = /styles.css {
        try_files /styles.css =404;
    }

    location = /journey.css {
        try_files /journey.css =404;
    }

    location = /script.js {
        try_files /script.js =404;
    }

    location = /journey.js {
        try_files /journey.js =404;
    }

    location = /auth.js {
        try_files /auth.js =404;
    }

    location = /debug-logger-core.js {
        try_files /debug-logger-core.js =404;
    }

    location = /debug-logger.js {
        try_files /debug-logger.js =404;
    }

    location = /journey-curve-import-core.js {
        try_files /journey-curve-import-core.js =404;
    }

    location = /assets/icon.svg {
        try_files /assets/icon.svg =404;
    }

    location = /assets/beian/gongan.png {
        try_files /assets/beian/gongan.png =404;
    }

    location = /api/homepage/canvas {
        limit_except GET HEAD {
            deny all;
        }
        proxy_pass http://127.0.0.1:8000/api/homepage/canvas;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }

    location ~ ^/api/homepage/media/[1-9][0-9]*/file$ {
        limit_except GET HEAD {
            deny all;
        }
        proxy_pass http://127.0.0.1:8000$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }

    location / {
        return 404;
    }
}
