[Unit]
Description=Personal_Web shared-development database and media backup
Documentation=file:/opt/personal-web/docs/14_SHARED_REMOTE_BACKUP_AND_RECOVERY.md

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/opt/personal-web/deploy/backup/create-shared-dev-backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/personal-web/shared-dev /run/lock
ReadOnlyPaths=/srv/personal-web/shared-dev/homepage
# runuser requires UID/GID transition to the postgres OS account while the
# root-owned service keeps backup files 0600 through shell redirection.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_DAC_READ_SEARCH
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
